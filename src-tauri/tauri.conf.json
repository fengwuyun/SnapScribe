{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapScribe",
  "version": "0.1.2",
  "identifier": "com.snapscribe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SnapScribe",
        "width": 1200,
        "height": 720,
        "minWidth": 1180,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": [
      "resources/bin/*",
      "resources/models/*"
    ]
  }
}
